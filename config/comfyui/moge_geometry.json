{
  "1": { "class_type": "LoadMoGeModel", "inputs": { "model_name": "{{checkpoint}}" } },
  "2": { "class_type": "LoadImage", "inputs": { "image": "{{ref_1}}" } },
  "3": { "class_type": "MoGeInference", "inputs": { "moge_model": ["1", 0], "image": ["2", 0], "resolution_level": 9, "fov_x_degrees": 0, "batch_size": 4, "force_projection": true, "apply_mask": false, "refine_steps": 3 } },
  "4": { "class_type": "MoGeRender", "inputs": { "moge_geometry": ["3", 0], "output": "normal_opengl" } },
  "5": { "class_type": "SaveImage", "inputs": { "filename_prefix": "gd_analysis/moge_n", "images": ["4", 0] } },
  "6": { "class_type": "MoGeRender", "inputs": { "moge_geometry": ["3", 0], "output": "depth" } },
  "7": { "class_type": "SaveImage", "inputs": { "filename_prefix": "gd_analysis/moge_d", "images": ["6", 0] } }
}
