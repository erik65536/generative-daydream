{
  "_comment": "Copy to config/genai.json. Each purpose names a provider; 'procedural' needs no model and is always the fallback. Providers sharing a 'gpu' group run one model at a time: the engine unloads one (llama.cpp router /models/unload, ComfyUI /free) before using another.",
  "providers": {
    "llm": {
      "type": "openai-chat",
      "baseUrl": "http://127.0.0.1:9931/v1",
      "model": "qwen3.8-27b",
      "structured": "json_schema",
      "vision": true,
      "concurrency": 1,
      "timeoutMs": 600000,
      "gpu": "local",
      "extraBody": {
        "chat_template_kwargs": {
          "enable_thinking": false
        }
      }
    },
    "decider": {
      "type": "llamacpp-decision",
      "baseUrl": "http://127.0.0.1:9931",
      "model": "vllm-d3-flash",
      "concurrency": 1,
      "timeoutMs": 120000,
      "gpu": "local"
    },
    "comfy-qwen": {
      "type": "comfyui",
      "baseUrl": "http://127.0.0.1:8188",
      "_comment": "editWorkflow paints variants (walking and attack poses, an opened chest) from an approved image as a reference, so they stay the same character. promptProfile picks the prompt wording for this model family (qwen-image-2, flux, sdxl); override any field in config/prompt-profiles/<id>.json.",
      "workflow": "config/comfyui/qwen_image_2_1_turbo_t2i.json",
      "editWorkflow": "config/comfyui/qwen_image_2_1_turbo_edit.json",
      "checkpoint": "qwen_image_2.1_turbo_int8_convrot.safetensors",
      "promptStyle": "descriptive",
      "promptProfile": "qwen-image-2",
      "alpha": "native",
      "concurrency": 1,
      "timeoutMs": 300000,
      "gpu": "local"
    },
    "comfy-krea": {
      "type": "comfyui",
      "baseUrl": "http://127.0.0.1:8188",
      "workflow": "config/comfyui/krea2_turbo_t2i.json",
      "checkpoint": "krea2_turbo_fp8_scaled.safetensors",
      "promptStyle": "descriptive",
      "alpha": "cutout",
      "concurrency": 1,
      "timeoutMs": 300000,
      "gpu": "local"
    },
    "comfy-sdxl": {
      "type": "comfyui",
      "baseUrl": "http://127.0.0.1:8188",
      "workflow": "config/comfyui/sdxl_txt2img.json",
      "checkpoint": "sd_xl_base_1.0.safetensors",
      "steps": 28,
      "cfg": 6.5,
      "concurrency": 1,
      "gpu": "local",
      "promptStyle": "tags",
      "alpha": "cutout"
    },
    "openai": {
      "type": "openai-responses",
      "apiKey": "env:OPENAI_API_KEY",
      "model": "gpt-5-mini"
    },
    "openai-images": {
      "type": "openai-image",
      "apiKey": "env:OPENAI_API_KEY",
      "model": "gpt-image-1"
    },
    "anthropic": {
      "type": "anthropic",
      "apiKey": "env:ANTHROPIC_API_KEY",
      "model": "claude-opus-5-5"
    },
    "gemini": {
      "type": "google",
      "apiKey": "env:GEMINI_API_KEY",
      "model": "gemini-2.5-flash"
    },
    "gemini-images": {
      "type": "google-image",
      "apiKey": "env:GEMINI_API_KEY",
      "model": "gemini-2.5-flash-image"
    }
  },
  "purposes": {
    "world.design": {
      "provider": "llm",
      "temperature": 0.9,
      "maxTokens": 8000,
      "retries": 2
    },
    "world.content": {
      "provider": "llm",
      "temperature": 0.85,
      "maxTokens": 9000,
      "retries": 2
    },
    "npc.decision": {
      "provider": "llm",
      "temperature": 0.7,
      "maxTokens": 900,
      "retries": 1
    },
    "npc.dialogue": {
      "provider": "llm",
      "temperature": 0.8,
      "maxTokens": 400
    },
    "narration": {
      "provider": "llm",
      "temperature": 0.8,
      "maxTokens": 400
    },
    "image.prompt": {
      "provider": "llm",
      "temperature": 0.7,
      "maxTokens": 4000,
      "retries": 1
    },
    "image.texture": {
      "provider": "comfy-qwen",
      "width": 1024,
      "height": 1024,
      "maxAttempts": 3
    },
    "image.sprite": {
      "provider": "comfy-qwen",
      "width": 832,
      "height": 1216,
      "maxAttempts": 3
    },
    "image.icon": {
      "provider": "comfy-qwen",
      "width": 1024,
      "height": 1024,
      "maxAttempts": 2
    },
    "image.check": {
      "provider": "decider",
      "minScore": 6
    }
  },
  "combineNpcDecisionAndDialogue": true,
  "worldGenParallelism": 1,
  "gpuIdleUnloadMs": 120000,
  "jobConcurrency": 1,
  "waitForModelsMs": 1800000
}