# The game server: HTTP API, game sockets and the built client, behind Caddy on this machine.
[Unit]
Description=Generative Daydream game server
After=network-online.target
Wants=network-online.target

[Service]
User=gd
Group=gd
WorkingDirectory=/opt/gd/packages/server
ExecStart=/opt/gd/node_modules/.bin/tsx src/index.ts
Environment=NODE_ENV=production GD_HOST=127.0.0.1 GD_PORT=3000 GD_WORKER=external
Environment=GD_DATA_DIR=/var/lib/gd GD_GENAI_CONFIG=/etc/gd/genai.json
# The OpenAI key: a file only this service can read (provider "apiKey": "credential:openai"), never in the environment.
LoadCredentialEncrypted=openai
# The GPU broker's token (comfy provider "apiKey": "credential:gpu-broker").
LoadCredentialEncrypted=gpu-broker
Restart=always
RestartSec=2
# Saves are written on SIGTERM.
TimeoutStopSec=30

StateDirectory=gd
StateDirectoryMode=0750
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes

[Install]
WantedBy=multi-user.target
